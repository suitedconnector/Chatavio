{
  "manifest_version": 3,
  "name": "Chatavio - AI Chat Exporter",
  "version": "1.1",
  "description": "Export 20 chats/DAY free from Perplexity, Gemini, ChatGPT, Claude, and NotebookLM",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatavio - AI Chat Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["jszip.min.js"],
    "matches": [
      "https://claude.ai/*",
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://www.perplexity.ai/*",
      "https://perplexity.ai/*",
      "https://gemini.google.com/*",
      "https://aistudio.google.com/*",
      "https://notebooklm.google.com/*"
    ],
    "use_dynamic_url": false
  }]
}
